{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midnight.ci-evidence/1",
  "title": "CI Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "run_id",
    "required_status_checks_policy",
    "required_status_checks_observed",
    "host_readable",
    "match",
    "payload_digest"
  ],
  "properties": {
    "schema": { "const": "midnight.ci-evidence/1" },
    "run_id": { "type": "string", "minLength": 1 },
    "sha": { "type": "string" },
    "repository": { "type": "string" },
    "ref": { "type": "string" },
    "workflow": { "type": "string" },
    "required_status_checks_policy": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_status_checks_observed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "host_readable": { "type": "boolean" },
    "match": { "type": "boolean" },
    "artifact_name": { "type": "string" },
    "payload_digest": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string" }
  }
}
