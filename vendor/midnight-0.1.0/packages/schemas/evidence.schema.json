{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Manifest",
  "type": "object",
  "required": [
    "schema",
    "release_revision_digest",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "midnight.evidence/1"
    },
    "release_revision_digest": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run",
              "stale"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    }
  }
}
