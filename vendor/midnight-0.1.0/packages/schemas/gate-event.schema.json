{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midnight.gate-event/1",
  "title": "Gate Event",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "gate",
    "actor_id",
    "subject_digest",
    "decision",
    "payload_digest",
    "evidence_ref",
    "signed_at"
  ],
  "properties": {
    "schema": {
      "const": "midnight.gate-event/1"
    },
    "gate": {
      "type": "string",
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "payload_digest": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bundle_digest": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
