{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midnight.requirement/1",
  "title": "Requirement",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "title",
    "revision",
    "goal",
    "acceptance_criteria"
  ],
  "properties": {
    "schema": {
      "const": "midnight.requirement/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requester_development_literacy", "method"],
      "properties": {
        "requester_development_literacy": {
          "type": "string",
          "enum": ["NON_TECHNICAL", "TECHNICAL"]
        },
        "method": {
          "type": "string",
          "enum": ["CODE", "E2E"]
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
