{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "midnight.waiver/1",
  "title": "Waiver",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "rule_ids",
    "residual_risk",
    "actor_id",
    "evidence_ref",
    "signed_at"
  ],
  "properties": {
    "schema": {
      "const": "midnight.waiver/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rule_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1
    },
    "signed_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
